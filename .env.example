# ---- Puertos en tu máquina (Docker) ----
# WEB_PORT=3000
# API_PORT=8000

# ---- API ----
# Clave para firmar tokens. Si la dejás vacía se genera sola y se guarda
# en el volumen de datos. Para fijarla:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Base de datos. Por defecto SQLite (cero configuración).
# Para Postgres: postgresql+psycopg://usuario:clave@host/hashly
# (y agregá psycopg[binary] a api/requirements.txt)
# DATABASE_URL=sqlite:////app/data/hashly.db

# Orígenes permitidos para el navegador (separados por coma)
CORS_ORIGINS=http://localhost:3000

# Límites de subida
MAX_FILES=100
MAX_FILE_SIZE=52428800
MAX_TOTAL_SIZE=524288000

# Plan gratis (0 = sin límite)
MAX_PACKAGES_PER_USER=1000
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# ---- OpenTimestamps ----
# OTS_CALENDARS=https://alice.btc.calendar.opentimestamps.org,https://bob.btc.calendar.opentimestamps.org
OTS_WORKER_INTERVAL=600
OTS_MAX_PENDING_DAYS=7

# ---- Web ----
# URL pública del API, vista desde el navegador (se incrusta al construir)
NEXT_PUBLIC_API_URL=http://localhost:8000
